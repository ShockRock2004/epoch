{
  "expo": {
    "name": "Epoch",
    "slug": "epoch",
    "scheme": "epoch",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07040C",
    "android": {
      "package": "com.epoch.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#07040C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#07040C"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Montserrat_400Regular.ttf",
            "./assets/fonts/Montserrat_500Medium.ttf",
            "./assets/fonts/Montserrat_600SemiBold.ttf",
            "./assets/fonts/Montserrat_700Bold.ttf",
            "./assets/fonts/Montserrat_800ExtraBold.ttf"
          ]
        }
      ]
    ]
  }
}
